# =============================================================================
# RUNPOD SERVERLESS DOCKERFILE
# 
# BraTS 3D Tumor Segmentation GPU Container
# Build: docker build -f Dockerfile.runpod -t brats-runpod .
# Push:  docker push <your-dockerhub>/brats-runpod:latest
# =============================================================================

# Base image with PyTorch + CUDA
FROM runpod/pytorch:2.1.0-py3.10-cuda11.8.0-devel-ubuntu22.04

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV MODEL_PATH=/app/unet_modified_83_38.pth
ENV WARMUP_ON_START=true

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements_runpod.txt .

# Install Python dependencies
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements_runpod.txt

# Copy model file (large file - should be one of the last steps)
COPY unet_modified_83_38.pth .

# Copy application code
COPY stable_unet3d.py .
COPY inference_stable.py .
COPY visualize_3d.py .
COPY report_generator.py .
COPY runpod_handler.py .

# Verify model file exists
RUN python -c "import torch; state = torch.load('unet_modified_83_38.pth', map_location='cpu'); print(f'✅ Model loaded: {len(state)} keys')"

# Set entrypoint
CMD ["python", "-u", "runpod_handler.py"]
