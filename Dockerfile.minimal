# Ultra-minimal Dockerfile - No apt-get
FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime

ENV PYTHONUNBUFFERED=1
ENV MODEL_PATH=/app/unet_modified_83_38.pth

WORKDIR /app

# Skip apt-get - install Python packages only
RUN pip install --no-cache-dir \
    runpod>=1.6.0 \
    SimpleITK>=2.3.0 \
    nibabel>=5.0.0 \
    scikit-image>=0.21.0 \
    scipy>=1.10.0 \
    reportlab>=4.0.0 \
    trimesh>=4.0.0 \
    "pyglet<2.0" \
    aiofiles>=23.0.0

COPY unet_modified_83_38.pth .
COPY stable_unet3d.py .
COPY inference_stable.py .
COPY visualize_3d.py .
COPY report_generator.py .
COPY runpod_handler.py .

CMD ["python", "-u", "runpod_handler.py"]
